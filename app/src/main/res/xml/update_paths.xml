<?xml version="1.0" encoding="utf-8"?>
<!--
    Files the app hands to other apps through its one FileProvider (authority ${applicationId}.updates):
    a downloaded update, shared only with Android's package installer, and files the user chooses to share
    (such as the tax estimate image or PDF), written to cache/shared/ just before the share sheet opens.
-->
<paths>
    <cache-path name="updates" path="updates/" />
    <cache-path name="shared" path="shared/" />
</paths>
