<resources>
    <color name="brand">#FF1B6E4F</color>
    <color name="window_light">#FFF6FAF7</color>
    <color name="window_dark">#FF101412</color>
    <!-- Window theme only; every screen is drawn with Compose. -->
    <style name="Theme.Hisaab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Hisaab.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Hisaab</item>
    </style>
</resources>
